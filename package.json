{
  "name": "openclaw-render",
  "version": "2.0.0",
  "private": true,
  "description": "OpenClaw on Render — one-click deploy, powered by @chrysb/alphaclaw",
  "scripts": {
    "test": "node --test",
    "dev": "docker compose up --build",
    "dev:stop": "docker compose down",
    "dev:clean": "docker compose down -v",
    "dev:logs": "docker compose logs -f",
    "dev:shell": "docker compose exec openclaw bash"
  },
  "dependencies": {
    "@chrysb/alphaclaw": "https://github.com/chrysb/alphaclaw/archive/c3c9d023ba3c74a535a3cfb04e063f6c499554fa.tar.gz"
  },
  "engines": {
    "node": ">=22.22.3 <23"
  }
}
